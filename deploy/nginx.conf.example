# 音遇 · 生产部署反代样例（nginx）
# 用法：放到 /etc/nginx/sites-available/yinyu ，证书路径换成你自己的，
#       然后 ln -s 到 sites-enabled 并 nginx -s reload。
# 服务器侧记得设 TRUST_PROXY=1（nginx 后才读 X-Forwarded-For 做限频）。

# HTTP → HTTPS 强制跳转
server {
    listen 80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # WebSocket + HTTP 反代到 Colyseus（默认 2567）
    location / {
        proxy_pass http://127.0.0.1:2567;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 连接级限速：单 IP 最多 8 条并发（语音 WebRTC 信令 + 游戏本体通常 1-2 条）
        limit_conn perip_conn 8;
        # 带宽：单连接 2m/s 足够（音频上传走 /songs/upload 单独放宽）
        limit_rate_after 1m;
        limit_rate 2m;

        proxy_read_timeout 300s;   # WS 长连接不断
        proxy_send_timeout 300s;
        client_max_body_size 64k;  # 游戏消息都很小
    }

    # 音频上传（服务器侧 20MB 上限，这里放宽到 25m 余量）
    location /songs/upload {
        proxy_pass http://127.0.0.1:2567;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 25m;
        limit_req zone=upload burst=5 nodelay;  # 与服务器内的 10 分钟 3 首叠加
    }

    # 音频下发：可以缓存
    location /songs/file/ {
        proxy_pass http://127.0.0.1:2567;
        proxy_set_header Host $host;
        proxy_cache_valid 200 24h;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
}

# 全局限速区（放 nginx.conf 的 http{} 里，或本文件被 include 到 http{} 级别时生效）
# limit_conn_zone $binary_remote_addr zone=perip_conn:10m;
# limit_req_zone  $binary_remote_addr zone=upload:10m rate=6r/m;
